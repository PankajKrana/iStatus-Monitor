<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      iStatus Monitor reads hardware telemetry entirely on-device. It does not
      collect, transmit, or track any user or device data, and contains no
      third-party SDKs. The only declarations below are the "required reason"
      APIs the app legitimately uses to render local system metrics.
    -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- @AppStorage / UserDefaults for the app's own settings (widget
             config, accent color, alert rules). App-scoped use only. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
        <!-- Volume capacity (volumeTotalCapacity / volumeAvailableCapacity) read
             only to DISPLAY SSD usage to the person using the device — the app
             does not gate any file writes on free space. 85F4.1 is Apple's
             "display disk space to the person using the device" reason; E174.1
             (check-before-write) would not apply here. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryDiskSpace</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>85F4.1</string>
            </array>
        </dict>
        <!-- ProcessInfo.systemUptime used to display system uptime and to
             measure elapsed time between samples. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategorySystemBootTime</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>35F9.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
